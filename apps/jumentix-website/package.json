{
  "name": "@jumentix/website",
  "version": "0.0.2",
  "private": true,
  "packageManager": "pnpm@9.15.3",
  "scripts": {
    "content:sync": "node ./scripts/sync-markdown-content.mjs",
    "content:smoke": "node ./scripts/content-smoke.mjs",
    "predev": "node ./scripts/sync-markdown-content.mjs",
    "prebuild": "node ./scripts/sync-markdown-content.mjs",
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static",
    "storybook:smoke": "node ./scripts/storybook-smoke.mjs",
    "test:prepublish": "bun run content:sync && bun run content:smoke && node ./scripts/prepublish-site-checks.mjs",
    "test": "bun run typecheck",
    "vercel:link": "vercel link --project jumentix-website --yes",
    "vercel:pull:preview": "vercel pull --environment=preview --yes",
    "vercel:pull:prod": "vercel pull --environment=production --yes",
    "deploy:vercel": "vercel --prod",
    "deploy:vercel:safe": "bun run test:prepublish && bun run deploy:vercel",
    "deploy:vercel:preview": "vercel"
  },
  "dependencies": {
    "@gfazioli/mantine-border-animate": "^2.0.7",
    "@gfazioli/mantine-marquee": "^4.1.2",
    "@gfazioli/mantine-text-animate": "^4.0.6",
    "@mantine/core": "9.4.0",
    "@mantine/hooks": "9.4.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/bundle-analyzer": "^16.2.11",
    "@tabler/icons-react": "^3.44.0",
    "@vercel/analytics": "^1.6.1",
    "clsx": "^2.1.1",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.4",
    "@theguild/remark-mermaid": "^0.3.0",
    "@storybook/addon-docs": "10.5.4",
    "@storybook/addon-themes": "10.5.4",
    "@storybook/nextjs": "10.5.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "19.2.17",
    "postcss": "^8.5.23",
    "postcss-import": "^16.1.1",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "storybook": "10.5.4",
    "turbopack-inline-svg-loader": "^1.0.3",
    "typescript": "6.0.3"
  }
}
