{
  "name": "@jumentix/website",
  "version": "0.0.2",
  "private": true,
  "packageManager": "pnpm@9.15.3",
  "scripts": {
    "content:sync": "node ./scripts/sync-markdown-content.mjs",
    "predev": "node ./scripts/sync-markdown-content.mjs",
    "prebuild": "node ./scripts/sync-markdown-content.mjs",
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck",
    "vercel:link": "vercel link --scope web2solutions --project jumentix-website --yes",
    "vercel:pull:preview": "vercel pull --environment=preview --scope web2solutions --yes",
    "vercel:pull:prod": "vercel pull --environment=production --scope web2solutions --yes",
    "deploy:vercel": "vercel --scope web2solutions --prod",
    "deploy:vercel:preview": "vercel --scope web2solutions"
  },
  "dependencies": {
    "@gfazioli/mantine-border-animate": "^2.0.7",
    "@gfazioli/mantine-marquee": "^4.1.2",
    "@gfazioli/mantine-text-animate": "^4.0.6",
    "@mantine/core": "9.4.0",
    "@mantine/hooks": "9.4.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/bundle-analyzer": "^16.2.9",
    "@tabler/icons-react": "^3.44.0",
    "@vercel/analytics": "^1.6.1",
    "clsx": "^2.1.1",
    "next": "16.2.9",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "19.2.17",
    "postcss": "^8.5.15",
    "postcss-import": "^16.1.1",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "turbopack-inline-svg-loader": "^1.0.3",
    "typescript": "6.0.3"
  }
}
