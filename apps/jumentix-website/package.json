{
  "name": "@jumentix/website",
  "version": "0.2.10",
  "private": true,
  "packageManager": "bun@1.3.13",
  "scripts": {
    "content:sync": "bun ./scripts/sync-markdown-content.mjs && bun ./scripts/sync-changelog.mjs && bun ./scripts/sync-releases.mjs",
    "content:smoke": "bun ./scripts/content-smoke.mjs",
    "examples:cana:downloads": "bun ./scripts/build-cana-example-downloads.mjs",
    "predev": "bun ./scripts/sync-markdown-content.mjs",
    "prebuild": "bun ./scripts/sync-markdown-content.mjs && bun ./scripts/sync-changelog.mjs && bun ./scripts/sync-releases.mjs",
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build -o storybook-static",
    "storybook:smoke": "bun ./scripts/storybook-smoke.mjs",
    "test:cypress": "bun ./scripts/run-cypress.mjs",
    "test:prepublish": "bun run content:sync && bun run content:smoke && bun ./scripts/prepublish-site-checks.mjs",
    "test:quality": "bun run test:unit && bun run test:prepublish && bun run test:routes && bun run storybook:build && bun run storybook:smoke && bun run test:cypress",
    "test": "bun run typecheck && bun run test:unit",
    "vercel:link": "vercel link --project jumentix-website --yes",
    "vercel:pull:preview": "vercel pull --environment=preview --yes",
    "vercel:pull:prod": "vercel pull --environment=production --yes",
    "deploy:vercel": "bun run test:quality && vercel --prod",
    "deploy:vercel:safe": "bun run test:prepublish && bun run deploy:vercel",
    "deploy:vercel:preview": "vercel",
    "routes:discover": "bun ./scripts/discover-routes.mjs",
    "test:routes": "bun ./scripts/route-sweep.mjs",
    "test:unit": "jest"
  },
  "dependencies": {
    "@gfazioli/mantine-border-animate": "^2.0.7",
    "@gfazioli/mantine-marquee": "^4.1.2",
    "@gfazioli/mantine-text-animate": "^4.0.6",
    "@jumentix/cana": "workspace:*",
    "@jumentix/designer-core": "workspace:*",
    "@jumentix/key-value-storage": "workspace:*",
    "@jumentix/message-mediator": "workspace:*",
    "@jumentix/mutex-service": "workspace:*",
    "@jumentix/sdk-rest-client": "workspace:*",
    "@jumentix/sdk-websocket-client": "workspace:*",
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/bundle-analyzer": "^16.2.11",
    "@reduxjs/toolkit": "^2.12.0",
    "@tabler/icons-react": "^3.44.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.56.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "pinia": "^4.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "^9.3.0",
    "swr": "^2.4.2",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/nextjs": "10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@theguild/remark-mermaid": "^0.3.0",
    "@types/axe-core": "^3.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.12.1",
    "cypress-axe": "^1.7.0",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.23",
    "postcss-import": "^17.0.0",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "storybook": "10.6.0",
    "turbopack-inline-svg-loader": "^1.0.3",
    "typescript": "6.0.3"
  }
}
