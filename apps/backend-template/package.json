{
  "name": "@jumentix/backend-template",
  "version": "0.0.2",
  "private": true,
  "description": "JumentiX backend template workspace app",
  "scripts": {
    "build": "NODE_ENV=dev tsc -p ../../tsconfig.build.json",
    "build:dev": "NODE_ENV=dev tsc -p ../../tsconfig.build.json",
    "test": "NODE_ENV=dev bun ../../ci-cd/run-unit-tests.js",
    "test:unit": "NODE_ENV=dev bun ../../ci-cd/run-unit-tests.js",
    "test:integration": "NODE_ENV=dev jest ./test/integration --runInBand",
    "test:integration:smoke": "AAA_JWT_TOKEN_SECRET_KEY=${AAA_JWT_TOKEN_SECRET_KEY:-ci_jwt_secret_key} NODE_ENV=ci bun ../../ci-cd/run-api-smoke.js",
    "lint": "eslint src test --ext .ts",
    "coverage:patch": "bun ../../ci-cd/check-patch-coverage.js",
    "ci:gate": "pnpm --prefix ../.. run ci:gate",
    "ci:gate:strict": "pnpm --prefix ../.. run ci:gate:strict",
    "typecheck": "NODE_ENV=dev tsc -p ../../tsconfig.build.json --noEmit",
    "dev:rest": "bun run dev:http --prefix ../..",
    "dev:websocket-rest": "bun run dev:websocket --prefix ../..",
    "dev:grpc-rest": "bun run dev:grpc --prefix ../..",
    "pm2:start:dev:restapi": "bun run pm2:start:dev:restapi --prefix ../..",
    "pm2:start:dev:websocket-rest": "bun run pm2:start:dev:websocket-rest --prefix ../..",
    "pm2:start:dev:grpc-rest": "bun run pm2:start:dev:grpc-rest --prefix ../..",
    "pm2:start:staging:restapi": "bun run pm2:start:staging:restapi --prefix ../..",
    "pm2:start:staging:websocket-rest": "bun run pm2:start:staging:websocket-rest --prefix ../..",
    "pm2:start:staging:grpc-rest": "bun run pm2:start:staging:grpc-rest --prefix ../..",
    "pm2:start:prod:restapi": "bun run pm2:start:prod:restapi --prefix ../..",
    "pm2:start:prod:websocket-rest": "bun run pm2:start:prod:websocket-rest --prefix ../..",
    "pm2:start:prod:grpc-rest": "bun run pm2:start:prod:grpc-rest --prefix ../.."
  }
}
