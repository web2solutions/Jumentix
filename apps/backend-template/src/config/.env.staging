## get passwords from env
JUMENTIX_REDIS_HOST=127.0.0.1
JUMENTIX_REDIS_PORT=6379
JUMENTIX_REDIS_DATABASE=1
#JUMENTIX_REDIS_PASSWORD=

#JUMENTIX_JWT_TOKEN_SECRET_KEY=

#JUMENTIX_ACCESS_TOKEN_PRIVATE_KEY=
#JUMENTIX_ACCESS_TOKEN_PUBLIC_KEY=
#JUMENTIX_REFRESH_TOKEN_PRIVATE_KEY=
#JUMENTIX_REFRESH_TOKEN_PUBLIC_KEY=

#JUMENTIX_GOOGLE_OAUTH_CLIENT_ID=
#JUMENTIX_GOOGLE_OAUTH_CLIENT_SECRET=
#JUMENTIX_GOOGLE_OAUTH_REDIRECT_URL=

#JUMENTIX_GITHUB_OAUTH_CLIENT_ID=
#JUMENTIX_GITHUB_OAUTH_CLIENT_SECRET=
#JUMENTIX_GITHUB_OAUTH_REDIRECT_URL=

# Runtime adapter selection
JUMENTIX_HTTP_FRAMEWORK=express
JUMENTIX_REALTIME_API=no
JUMENTIX_REALTIME_API_PROTOCOL=websocket
# Socket.IO scaling adapter: cluster | redis-streams | (empty for in-memory adapter)
#JUMENTIX_WEBSOCKET_SOCKETIO_ADAPTER=redis-streams
#JUMENTIX_WEBSOCKET_CLUSTER_WORKERS=4
# Optional dedicated Redis URL for Socket.IO adapter
#JUMENTIX_WEBSOCKET_REDIS_URL=redis://127.0.0.1:6379/1
JUMENTIX_DATABASE_DRIVER=Mongo
JUMENTIX_DATABASE_NAME=jumentix
#JUMENTIX_DATABASE_CONNECTION_URL=
#JUMENTIX_DATABASE_DIALECT=postgres
#JUMENTIX_DATABASE_REGION=us-east-1
#JUMENTIX_DATABASE_ENDPOINT=http://127.0.0.1:8000
#JUMENTIX_DATABASE_PROJECT_ID=demo-project
#JUMENTIX_DATABASE_CASSANDRA_CONTACT_POINTS=127.0.0.1
#JUMENTIX_DATABASE_CASSANDRA_DATACENTER=datacenter1

# Auth security controls
JUMENTIX_ENABLE_BASIC_AUTH=no
JUMENTIX_AUTH_MAX_LOGIN_ATTEMPTS=5
JUMENTIX_AUTH_LOGIN_WINDOW_SECONDS=300
JUMENTIX_AUTH_LOCKOUT_SECONDS=900

# JWT security controls
#JUMENTIX_JWT_ISSUER=jumentix
#JUMENTIX_JWT_AUDIENCE=jumentix-clients

# CORS security controls (comma-separated origins)
#JUMENTIX_CORS_ALLOWED_ORIGINS=https://staging.example.com
