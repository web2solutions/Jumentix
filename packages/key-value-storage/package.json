{
  "name": "@jumentix/key-value-storage",
  "version": "0.0.0",
  "description": "Jumentix reusable key-value storage adapters",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "README.pt-BR.md"
  ],
  "dependencies": {
    "redis": "^6.2.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test --isolate test",
    "lint": "echo \"key-value-storage package lint pending\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build"
  },
