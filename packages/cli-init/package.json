{
  "name": "@jumentix/cli-init",
  "version": "0.0.0",
  "private": true,
  "description": "Jumentix factory generator CLI (Req 037 v2)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "jumentix": "./bin/jumentix.js",
    "jumentix-init": "./bin/jumentix-init.js",
    "jumentix-bootstrap": "./bin/jumentix-init.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build-templates": "bun scripts/build-templates.js",
    "check-template-freshness": "bun scripts/check-template-freshness.js",
    "pretest": "bun run build",
    "test": "bun test --isolate ./test",
    "lint": "echo \"cli-init: lint managed by root workspace\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
