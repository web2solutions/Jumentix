{
  "name": "@jumentix/cli-init",
  "version": "0.0.0",
  "description": "Jumentix factory generator CLI (Req 037 v2)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "jumentix": "./bin/jumentix.js",
    "jumentix-init": "./bin/jumentix-init.js",
    "jumentix-bootstrap": "./bin/jumentix-init.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md",
    "LICENSE.md",
    "README.pt-BR.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build-templates": "bun scripts/build-templates.js",
    "check-template-freshness": "bun scripts/check-template-freshness.js",
    "pretest": "bun run build",
    "test": "bun test --isolate ./test",
    "lint": "echo \"cli-init: lint managed by root workspace\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/web2solutions/Jumentix.git",
    "directory": "packages/cli-init"
  },
  "homepage": "https://jumentix-website.vercel.app",
  "bugs": {
    "url": "https://github.com/web2solutions/Jumentix/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
