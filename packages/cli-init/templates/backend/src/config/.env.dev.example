#JUMENTIX_REDIS_CONNECT_TIMEOUT_MS=5000
#JUMENTIX_REDIS_MAX_RECONNECT_ATTEMPTS=3

#JUMENTIX_JWT_TOKEN_SECRET_KEY=jwt secret goes here

#JUMENTIX_ACCESS_TOKEN_PRIVATE_KEY=
