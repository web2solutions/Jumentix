{
  "name": "@jumentix/cana",
  "version": "0.1.0",
  "description": "Cana — offline-first IndexedDB database client for Jumentix, in pure TypeScript.",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
