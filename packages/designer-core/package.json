{
  "name": "@jumentix/designer-core",
  "version": "0.1.0",
  "description": "Framework-free Service Management designer core — domain model, validation engine, exporters, importers and domain-package versioning as browser-safe ESM, with no DOM and no storage implementation.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun scripts/build.js",
    "clean": "rm -rf dist",
    "test": "bun test --isolate test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "README.pt-BR.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/web2solutions/Jumentix.git",
    "directory": "packages/designer-core"
  },
  "homepage": "https://jumentix-website.vercel.app",
  "bugs": {
    "url": "https://github.com/web2solutions/Jumentix/issues"
  },
  "keywords": [
    "designer",
    "domain-model",
    "validation",
    "openapi",
    "asyncapi",
    "exporters",
    "importers",
    "framework-free",
    "jumentix"
  ],
  "engines": {
    "node": ">=20"
  }
}
