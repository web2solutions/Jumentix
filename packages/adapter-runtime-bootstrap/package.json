{
  "name": "@jumentix/adapter-runtime-bootstrap",
  "version": "0.1.0",
  "description": "Shared adapter runtime bootstrap compiler for Jumentix services.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "README.pt-BR.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ./src --ext .ts",
    "test": "bun test --isolate test",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/web2solutions/Jumentix.git",
    "directory": "packages/adapter-runtime-bootstrap"
  },
  "homepage": "https://jumentix-website.vercel.app",
  "bugs": {
    "url": "https://github.com/web2solutions/Jumentix/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@jumentix/runtime-infra": "^0.1.0"
  },
  "devDependencies": {
    "@jumentix/runtime-infra": "workspace:*"
  }
}
