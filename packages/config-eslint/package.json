{
  "name": "@jumentix/config-eslint",
  "version": "0.1.0",
  "private": true,
  "description": "Jumentix shared ESLint 9 flat configuration built on eslint-config-airbnb-extended. Single source for every ESLint rule in the monorepo (base, typescript, node, vue, reactNextA11y, test and stylistic profiles, each with a strict variant).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.pt-BR.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "bun run build",
    "test": "bun test --isolate test",
    "prepublishOnly": "bun run clean && bun run build",
    "test:coverage": "bun test test --coverage --coverage-reporter=lcov --coverage-dir=../../coverage/config-eslint"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/web2solutions/Jumentix.git",
    "directory": "packages/config-eslint"
  },
  "dependencies": {
    "eslint-config-airbnb-extended": "3.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-no-async-foreach": "0.1.1",
    "eslint-plugin-vue": "10.11.0",
    "eslint-plugin-vuejs-accessibility": "2.6.0",
    "globals": "17.12.0",
    "typescript-eslint": "8.70.1",
    "vue-eslint-parser": "10.4.1"
  },
  "peerDependencies": {
    "eslint": "9.39.5"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "typescript": "5.4.5"
  }
}
