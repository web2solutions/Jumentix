#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "[Husky] pre-merge-commit: branch-aware quality gate"

# Replaces the nvm block that used to force Node 22. The intent was "run the
# gate on the runtime we support"; under Requirement 096 that runtime is the
# pinned Bun, and the guard asserts it rather than silently sourcing whatever
# nvm happens to have installed.
bun ci-cd/check-bun-version.js || exit 1

CI=true JUMENTIX_QUALITY_GATE_TARGET="$(git branch --show-current)" bun run ci:gate:branch
