#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "[Husky] pre-merge-commit: branch-aware quality gate"

if [ -s "$HOME/.nvm/nvm.sh" ]; then
  . "$HOME/.nvm/nvm.sh"
  nvm use 22 >/dev/null
fi

CI=true JUMENTIX_QUALITY_GATE_TARGET="$(git branch --show-current)" npx pnpm@9.15.3 run ci:gate:branch
