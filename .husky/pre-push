#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "[Husky] pre-push: branch-aware quality gate"

# Replaces the nvm block that used to force Node 22 — see pre-merge-commit.
bun ci-cd/check-bun-version.js || exit 1

# Requirement 111: refuse to push history containing undeclared commit
# identities. This runs explicitly before the branch gate so push authorization
# has a single, named failure point even when a reduced task gate is selected.
bun ci-cd/check-commit-authorship.js || exit 1

target_branch="$(git branch --show-current)"

while read -r local_ref local_sha remote_ref remote_sha
do
  case "$remote_ref" in
    refs/heads/main) target_branch="main" ;;
    refs/heads/dev) target_branch="dev" ;;
    refs/heads/*) target_branch="${remote_ref#refs/heads/}" ;;
  esac
done

CI=true JUMENTIX_QUALITY_GATE_TARGET="$target_branch" JUMENTIX_TASK_TEST_MODE=range JUMENTIX_TASK_TEST_BASE=origin/dev bun run ci:gate:branch
