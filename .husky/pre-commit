#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "[Husky] pre-commit: branch-aware quality gate"

# Assert the pinned toolchain first, so a version skew reports as a toolchain
# error here instead of as an unrelated gate failure three steps later.
bun ci-cd/check-bun-version.js || exit 1

# Requirement 111: refuse to stamp this commit with an undeclared identity.
# Before the gate, because the gate's range check cannot see a commit that does
# not exist yet — and commit metadata cannot be retracted once pushed.
bun ci-cd/check-commit-authorship.js --identity || exit 1

CI=true JUMENTIX_QUALITY_GATE_TARGET="$(git branch --show-current)" bun run ci:gate:branch
