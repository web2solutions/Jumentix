#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "[Husky] pre-commit: changelog + branch-aware quality gate"

# Assert the pinned toolchain first, so a version skew reports as a toolchain
# error here instead of as an unrelated gate failure three steps later.
bun ci-cd/check-bun-version.js || exit 1

bun run changelog:update &&
git add CHANGELOG.md &&
CI=true JUMENTIX_QUALITY_GATE_TARGET="$(git branch --show-current)" bun run ci:gate:branch
